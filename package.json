{
  "name": "@withwiz/auth-ui",
  "version": "0.3.0",
  "description": "Customizable authentication UI components for withwiz projects",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./components": { "types": "./dist/components/index.d.ts", "default": "./dist/components/index.js" },
    "./hooks": { "types": "./dist/hooks/index.d.ts", "default": "./dist/hooks/index.js" },
    "./styles": "./dist/styles/auth.css",
    "./i18n": { "types": "./dist/i18n/index.d.ts", "default": "./dist/i18n/index.js" },
    "./pages": { "types": "./dist/pages/index.d.ts", "default": "./dist/pages/index.js" }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup && tsc --emitDeclarationOnly",
    "build:js": "tsup",
    "build:types": "tsc --emitDeclarationOnly",
    "prepublishOnly": "rm -rf dist && npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18",
    "next": ">=15"
  },
  "dependencies": {
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.0.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "jsdom": "^25.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "next": "^15.0.0",
    "tsup": "^8.4.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "keywords": ["auth", "login", "react", "nextjs", "withwiz"],
  "license": "MIT"
}
