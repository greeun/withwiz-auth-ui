{
  "name": "@withwiz/auth-ui",
  "version": "0.6.2",
  "packageManager": "pnpm@11.24.0",
  "description": "Customizable authentication UI components for withwiz projects",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./components": {
      "types": "./dist/components/index.d.ts",
      "default": "./dist/components/index.js"
    },
    "./hooks": {
      "types": "./dist/hooks/index.d.ts",
      "default": "./dist/hooks/index.js"
    },
    "./styles": "./dist/styles/auth.css",
    "./i18n": {
      "types": "./dist/i18n/index.d.ts",
      "default": "./dist/i18n/index.js"
    },
    "./pages": {
      "types": "./dist/pages/index.d.ts",
      "default": "./dist/pages/index.js"
    },
    "./screens": {
      "types": "./dist/screens/index.d.ts",
      "default": "./dist/screens/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup && npm run copy:styles && tsc --emitDeclarationOnly",
    "build:js": "tsup && npm run copy:styles",
    "build:types": "tsc --emitDeclarationOnly",
    "copy:styles": "mkdir -p dist/styles && cp src/styles/*.css dist/styles/",
    "prepublishOnly": "rm -rf dist && npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "peerDependencies": {
    "next": ">=15",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.10.0",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^25.0.1",
    "next": "^16.3.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "keywords": [
    "auth",
    "login",
    "react",
    "nextjs",
    "withwiz"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/greeun/withwiz-auth-ui.git"
  },
  "homepage": "https://github.com/greeun/withwiz-auth-ui#readme",
  "bugs": {
    "url": "https://github.com/greeun/withwiz-auth-ui/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
